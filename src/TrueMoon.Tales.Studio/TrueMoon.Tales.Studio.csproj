<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(TF)</TargetFramework>
        <EnableCobaltGenerator>true</EnableCobaltGenerator>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="../TrueMoon.Tales.Studio.Contracts/TrueMoon.Tales.Studio.Contracts.csproj" />
        <ProjectReference Include="../TrueMoon.Tales.Studio.Persistence/TrueMoon.Tales.Studio.Persistence.csproj" />
        <InternalsVisibleTo Include="TrueMoon.Tales.Studio.Tests" />
        <PackageReference Include="TrueMoon" />
        <PackageReference Include="TrueMoon.Alloy.Hosting" />
        <PackageReference Include="TrueMoon.Cobalt" />
        <PackageReference Include="TrueMoon.Enerit" />
        <PackageReference Include="TrueMoon.Enerit.Generator" PrivateAssets="all" />
        <PackageReference Include="TrueMoon.Mithril" />
        <PackageReference Include="NAudio.WinMM" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../workers/export/studio/**/*.py;../../legacy/web/studio/**/*.py"
                 Exclude="../../legacy/web/studio/__init__.py" Link="ExportWorker/studio/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../../workers/export/RunExport.py" Link="ExportWorker/RunExport.py"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../../workers/full-transfer/Omni.v2/prepare.py;../../workers/full-transfer/Omni.v2/common.py;../../workers/full-transfer/Omni.v2/validate.py;../../workers/full-transfer/Omni.v2/server.py;../../workers/full-transfer/Omni.v2/driver.py;../../workers/full-transfer/Omni.v2/collect.py"
                 Link="FullTransferWorker/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../../workers/full-transfer/Omni.v2/Templates/*.json"
                 Link="FullTransferWorker/Templates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../../workers/full-transfer/ManagedRun.py" Link="FullTransferWorker/ManagedRun.py"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
