<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.2611.17.2-alpha</Version>
    <Authors>yotphiligan</Authors>
    <Company>TrueMoon</Company>
    <Product>TrueMoon.Tales.Studio</Product>
    <PackageTags>TrueMoon.Tales;dotnet;</PackageTags>
    <Copyright>Copyright © yotphiligan 2026</Copyright>

    <LangVersion>latest</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <TF>net11.0</TF>
    <TestsTF>net11.0</TestsTF>
  </PropertyGroup>

</Project>
