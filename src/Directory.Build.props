<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0.1-alpha</Version>
    <Authors>yotphiligan</Authors>
    <Company>TrueMoon</Company>
    <Product>TrueMoon.Tales.Studio</Product>
    <PackageTags>TrueMoon.Tales;dotnet;</PackageTags>
    <Copyright>Copyright © yotphiligan 2026</Copyright>

    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <TF>net10.0</TF>
    <TestsTF>net10.0</TestsTF>
  </PropertyGroup>

</Project>
