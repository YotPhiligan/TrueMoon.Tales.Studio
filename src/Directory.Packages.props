<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <StudioTrueMoonVersion Condition="'$(StudioTrueMoonVersion)' == ''">0.2.5.1-alpha</StudioTrueMoonVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="TrueMoon" Version="$(StudioTrueMoonVersion)" />
    <PackageVersion Include="TrueMoon.Alloy.Hosting" Version="$(StudioTrueMoonVersion)" />
    <PackageVersion Include="TrueMoon.Cobalt" Version="$(StudioTrueMoonVersion)" />
    <PackageVersion Include="NAudio.WinMM" Version="3.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <DotNetCliToolReference Include="dotnet-xunit" Version="2.3.1" />
  </ItemGroup>
</Project>
